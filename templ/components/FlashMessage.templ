package templ

import flash "github.com/alpemreelmas/sysara/pkg/flash"

var className string
templ FlashMessage(f flash.Flash) {
	    {{
            classMap := map[string]string{
                "success": "bg-green-100 border border-green-400 text-green-700",
                "error":   "bg-red-100 border border-red-400 text-red-700",
                "warning": "bg-yellow-100 border border-yellow-400 text-yellow-700",
                "info":    "bg-blue-100 border border-blue-400 text-blue-700",
            }
            className, ok := classMap[f.Type]
            if !ok {
                className = "bg-gray-100 border border-gray-400 text-gray-700"
            }
            fullClass := className + " px-4 py-3 rounded relative"
        }}

	<div class={fullClass} role="alert">
		<span class="block sm:inline">{ f.Message }</span>
		<span class="absolute top-0 bottom-0 right-0 px-4 py-3 cursor-pointer" onclick="this.parentElement.remove()">
			<i class="fas fa-times"></i>
		</span>
	</div>
}
